# EvalGuard AI settings.
# Copy this file to ".env" (same folder) and fill in the blanks. ".env" is ignored by git, so your keys stay private.
#   PowerShell:  copy .env.example .env

# ---------------------------------------------------------------- Which AI to use
# openrouter = free/paid models through OpenRouter (recommended)
# gemini     = Google Gemini API
# ollama     = a model running on your own computer
# mock       = fake answers and fixed fake scores, only for trying the app without any key
LLM_PROVIDER=openrouter

# OpenRouter: get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# The AI that answers the questions ...
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
# ... and a DIFFERENT AI that marks the answers (so it never marks its own work)
OPENROUTER_JUDGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Free model names change often: see https://openrouter.ai/models?q=free

# Only needed if LLM_PROVIDER=gemini. Chat also uses it as a free backup when the main model's daily limit is used up
# (free key from https://aistudio.google.com/apikey, no card needed).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Only needed if LLM_PROVIDER=ollama. Chat also uses it as a free backup when the main model's daily limit is used up
# (a small model like phi3 fits in about 3 GB of free RAM; llama3 needs about 6 GB).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_NUM_CTX=2048

# ---------------------------------------------------------------- Search and storage
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chroma_db
SQLITE_DB_PATH=./evalguard.db
RETRIEVAL_TOP_K=3
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ---------------------------------------------------------------- Quality bars
# Used when a domain doesn't set its own bar (healthcare, banking and legal are stricter)
FAITHFULNESS_THRESHOLD=0.70
RELEVANCE_THRESHOLD=0.70
# A drop is only called "drift" when the KS test p-value is below this number
DRIFT_P_VALUE_THRESHOLD=0.05

# ---------------------------------------------------------------- Web app access
# Which web addresses may call the API (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# The Clerk publishable key is read automatically from web/.env.local after you run "clerk env pull".
# Only set these if you want to override that:
# CLERK_PUBLISHABLE_KEY=
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# WHO may use the app. By default ANY signed-in Clerk user can, so before sharing the link either restrict
# sign-ups in the Clerk dashboard or list the allowed Clerk user ids here (comma separated, find them in
# the Clerk dashboard under Users). Anyone else gets a 403.
# EVALGUARD_ALLOWED_USER_IDS=user_abc123,user_def456
# Local experiments only, never on a shared machine: skips sign-in checks on the API
# EVALGUARD_AUTH_DISABLED=true
